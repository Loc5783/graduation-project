# ==============================================================================
# Cấu hình biến môi trường mẫu cho Backend Smart Home Privacy Dashboard
# Sao chép file này thành .env và điền các giá trị thực tế của môi trường.
# Tuyệt đối không commit file .env thật lên repository.
# ==============================================================================

# Cổng lắng nghe của máy chủ Backend Express (mặc định: 5000)
PORT=5000

# Môi trường chạy: development | production | test
NODE_ENV=development

# Địa chỉ kết nối MongoDB (Database phát triển: smart_home_privacy)
# Lưu ý: Không chia sẻ mật khẩu vào Git repository.
MONGODB_URI=mongodb://127.0.0.1:27017/smart_home_privacy

# Khóa bí mật dùng để ký và mã hóa phiên (Session Secret)
# Phải là chuỗi ngẫu nhiên đủ mạnh (tối thiểu 32 byte ngẫu nhiên)
# Ví dụ sinh khóa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=thay_the_bang_chuoi_ngau_nhien_du_manh_khi_trien_khai

# Danh sách Origin được phép truy cập API (phân tách bởi dấu phẩy)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000
