# ==============================================================================
# Cấu hình biến môi trường mẫu cho Smart Home Privacy Dashboard Frontend
# ==============================================================================

# Chế độ xem trước giao diện và layout (Chỉ hoạt động trong môi trường phát triển - Development):
# - true: Cho phép xem trước khung giao diện Dashboard (Overview & 5 module) mà không cần đăng nhập.
# - false: Tắt chế độ xem trước, yêu cầu xác thực người dùng bình thường (mặc định).
#
# LƯU Ý BẢO MẬT QUAN TRỌNG:
# Cơ chế xem trước CHỈ có hiệu lực khi chạy máy chủ dev (npm run dev).
# Khi đóng gói Production (npm run build), hệ thống luôn tự động TẮT hoàn toàn
# cơ chế này, bất kể cờ VITE_PREVIEW_MODE được đặt giá trị nào.
VITE_PREVIEW_MODE=false

# Cấu hình địa chỉ API máy chủ backend (dành cho giai đoạn tích hợp sau này):
# VITE_API_BASE_URL=http://localhost:8000/api
